<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PcAngerManager</AssemblyName>
    <RootNamespace>PcAngerManager</RootNamespace>
    <Product>PC분노관리</Product>
    <Version>0.1.1</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- 가볍게 돌리기 위한 설정 (완성본·개발용 공통) -->
  <PropertyGroup>
    <!-- 메모리 정리를 따로 도는 백그라운드 스레드 없이 함 → 스레드·메모리 절약 (작은 앱엔 충분) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- 한국어 외 번역 파일은 넣지 않음 -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 완성본(Release) 전용 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <!-- 미리 기계어로 번역해 둠 → 시작할 때 번역(JIT)에 드는 CPU·메모리 절약 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

</Project>
